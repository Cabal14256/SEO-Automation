{
  "name": "@scm/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/api.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "start": "node dist/api.js",
    "start:worker": "node dist/worker.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src drizzle.config.ts",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "batches:verify": "tsx src/batches-acceptance.ts --report ../../docs/acceptance/evidence/2026-10-17/t12-batches-integration.json",
    "sync:verify": "tsx src/sync-acceptance.ts --report ../../docs/acceptance/evidence/2026-10-17/t12-m2-sync-integration.json",
    "reports:verify": "tsx src/report-acceptance.ts --report ../../docs/acceptance/evidence/2026-10-17/t12-m2-report-concurrency.json",
    "seller-mappings:seed": "tsx src/modules/seller-mappings/seed.ts",
    "imports:verify": "tsx src/import-acceptance.ts",
    "imports:confirmation:verify": "tsx src/import-confirmation-acceptance.ts",
    "seller-catalog:verify": "tsx src/seller-catalog-acceptance.ts",
    "m0:verify": "tsx src/m0-acceptance.ts",
    "m0:verify-recovery": "tsx src/m0-recovery.ts",
    "admin:create": "auth create-admin --config src/auth.ts",
    "admin:verify": "tsx src/admin-only-acceptance.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.7",
    "@hono/node-server": "1.19.9",
    "@scm/contracts": "workspace:*",
    "better-auth": "1.7.7",
    "decimal.js": "10.6.0",
    "dotenv": "18.0.7",
    "drizzle-orm": "0.45.4",
    "exceljs": "4.4.0",
    "fast-xml-parser": "5.3.8",
    "fflate": "0.8.2",
    "hono": "4.13.13",
    "pg": "8.16.3",
    "pg-boss": "12.37.1",
    "yauzl": "3.4.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "24.9.1",
    "@types/pg": "8.15.5",
    "@types/yauzl": "3.4.0",
    "auth": "1.7.7",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "vitest": "5.0.3"
  }
}
