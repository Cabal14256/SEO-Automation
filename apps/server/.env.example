# Copy this file to apps/server/.env. Keep .env private.
DATABASE_URL=postgresql://scm_app:replace-me@127.0.0.1:5432/scm_automation
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:5173
HOST=127.0.0.1
PORT=3001
DATA_DIR=D:/SCM-Automation/.local/development/data
# WEB_DIST_DIR=D:/SCM-Automation/apps/web/dist
# Optional Lingxing read-only connection. Keep real values on the server only.
# Set false in restored/offline environments. Blocks business reads and token
# acquisition/refresh even when credentials or persisted tokens are present.
LINGXING_REQUESTS_ENABLED=true
# LINGXING_APP_ID=
# LINGXING_APP_SECRET=
# LINGXING_ACCESS_TOKEN=
# An explicit file is optional; the environment fields above take precedence.
# No credential file is loaded unless this server-side option is configured.
# LINGXING_ENV_FILE=D:/SCM-Automation/.local/development/lingxing.env
LINGXING_TIMEOUT_MS=30000
