    "db:migrate": "corepack pnpm --filter @scm/server db:migrate",
    "batches:verify": "corepack pnpm --filter @scm/server batches:verify",
    "sync:verify": "corepack pnpm --filter @scm/server sync:verify",
    "reports:verify": "corepack pnpm --filter @scm/server reports:verify",
    "m2:e2e": "node scripts/t12/m2-e2e.mjs",
    "m3:verify": "node scripts/m3/verify.mjs",
    "m3:browser": "node scripts/t26/batches-workspace-browser.mjs",
    "m4:verify": "node scripts/m4/verify.mjs",
    "m4:browser": "node scripts/m4/browser.mjs && node scripts/m4/box-values-browser.mjs && node scripts/m4/invoice-v2-browser.mjs && node scripts/m4/document-details-browser.mjs && node scripts/m4/document-defaults-browser.mjs && node scripts/m4/document-automation-browser.mjs && node scripts/m4/document-manual-price-browser.mjs",
    "m4:boxes:browser": "node scripts/m4/box-values-browser.mjs",
    "m4:sources:browser": "node scripts/m4/documents-source-browser.mjs",
    "m4:details:browser": "node scripts/m4/document-details-browser.mjs",
    "m4:defaults:browser": "node scripts/m4/document-defaults-browser.mjs",
    "m4:automation:browser": "node scripts/m4/document-automation-browser.mjs",
    "m4:manual-price:browser": "node scripts/m4/document-manual-price-browser.mjs",
    "m5-m8:verify": "node scripts/workflow/verify.mjs",
    "m5-m8:browser": "node scripts/m5-m8/browser.mjs",
    "acceptance:prepare": "node scripts/acceptance/cli.mjs prepare",
    "acceptance:preflight": "node scripts/acceptance/cli.mjs preflight",
    "acceptance:capture": "node scripts/acceptance/cli.mjs capture",
    "acceptance:package": "node scripts/acceptance/cli.mjs batch-package",
    "acceptance:signoff": "node scripts/acceptance/cli.mjs signoff",
    "acceptance:test": "node --test scripts/acceptance/core.test.mjs",
    "trial:package": "node scripts/trial/cli.mjs package",
    "trial:deploy": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/deployment/trial.ps1",
    "trial:backup": "node scripts/trial/cli.mjs backup",
    "trial:restore": "node scripts/trial/cli.mjs restore",
    "trial:verify": "node scripts/trial/cli.mjs verify",
    "trial:test": "node --test scripts/trial/core.test.mjs",
    "seller-mappings:seed": "corepack pnpm --filter @scm/server seller-mappings:seed",
    "imports:verify": "corepack pnpm --filter @scm/server imports:verify",
    "imports:browser": "node scripts/t09/imports-browser.mjs",
    "imports:confirmation:verify": "corepack pnpm --filter @scm/server imports:confirmation:verify",
    "imports:confirmation:browser": "node scripts/t11/import-confirmation-browser.mjs",
    "imports:workspace:verify": "node scripts/t24/import-workspace-integration.mjs",
    "imports:workspace:browser": "node scripts/t24/import-workspace-browser.mjs",
    "imports:wizard:browser": "node scripts/t25/import-wizard-browser.mjs",
    "imports:drafts:browser": "node scripts/t32/import-drafts-browser.mjs",
    "imports:auto:browser": "node scripts/t29/import-auto-parse-browser.mjs",
    "imports:pipeline:test": "node --test scripts/t33/online-import-pipeline.test.mjs",
    "settings:browser": "node scripts/t26/settings-browser.mjs",
    "seller-dialogs:browser": "node scripts/t30/seller-dialogs-browser.mjs",
    "batches:workspace:browser": "node scripts/t26/batches-workspace-browser.mjs",
    "batches:workspace:verify": "node scripts/t26/batches-workspace-integration.mjs",
    "shipping:browser": "node scripts/t34/shipping-integration-browser.mjs && node scripts/t36/shipping-tables-browser.mjs && node scripts/t38/shipping-unified-table-browser.mjs",
    "shipping:workbench:browser": "node scripts/t38/shipping-unified-table-browser.mjs",
    "shipping:runs:browser": "node scripts/t39/shipping-runs-browser.mjs",
    "batches:auto-confirm:browser": "node scripts/t35/auto-confirm-browser.mjs",
    "shipping:legacy:browser": "node scripts/t27/shipping-workspace-browser.mjs",
    "ui:browser": "node scripts/t24/shell-icons-browser.mjs && node scripts/t24/batch-icons-browser.mjs && node scripts/t26/settings-browser.mjs && node scripts/t26/batches-workspace-browser.mjs && node scripts/t34/shipping-integration-browser.mjs",
    "seller-catalog:verify": "corepack pnpm --filter @scm/server seller-catalog:verify",
    "seller-catalog:browser": "node scripts/t11/seller-catalog-browser.mjs",
    "seller-aliases:browser": "node scripts/t11/seller-aliases-browser.mjs",
    "m0:verify": "corepack pnpm --filter @scm/server m0:verify",
    "m0:verify-recovery": "corepack pnpm --filter @scm/server m0:verify-recovery",
    "admin:verify": "corepack pnpm --filter @scm/server admin:verify",
    "m0:browser": "node scripts/m0/browser-smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "1.64.1",
    "eslint": "^9.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}
