{
  "name": "scm-automation",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "monthly:db": "node scripts/t40/monthly-db.mjs",
