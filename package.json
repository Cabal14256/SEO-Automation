    "privacy:check": "node scripts/privacy/check.mjs",
    "privacy:history": "node scripts/privacy/check.mjs --history",
    "privacy:test": "node --test scripts/privacy/*.test.mjs",
    "privacy:export": "node scripts/privacy/export.mjs",
    "privacy:install-hook": "node scripts/privacy/install-hook.mjs",
    "path-policy:test": "node --test scripts/shared/path-policy.test.mjs",
    "lingxing:probe": "node scripts/lingxing/probe.mjs",
    "lingxing:probe:test": "node --test scripts/lingxing/probe.test.mjs",
